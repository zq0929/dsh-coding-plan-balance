{
  "name": "dsh-coding-plan-balance",
  "version": "1.1.0",
  "description": "Coding Plan quota pill for the DSH Web composer dock: billing-cycle usage, the separate auto-model and high-cost-model monthly buckets, today's spend and the rolling 5-hour window, read with the credential your ctrip model provider already uses.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zq0929/dsh-coding-plan-balance.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "coding-plan",
    "quota",
    "usage",
    "ctrip"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
